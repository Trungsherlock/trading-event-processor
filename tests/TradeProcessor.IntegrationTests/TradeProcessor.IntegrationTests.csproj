<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.Kafka" Version="4.17.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TradeProcessor.Infrastructure\TradeProcessor.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\TradeProcessor.Worker\TradeProcessor.Worker.csproj" />
    <ProjectReference Include="..\..\tools\TradeProducer\TradeProducer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same schema the Docker Compose Postgres uses -->
    <None Include="..\..\db\init.sql" Link="init.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shared with the unit tests, so there is one copy -->
    <Compile Include="..\TradeProcessor.UnitTests\TestData\TradeBuilder.cs" Link="TestData\TradeBuilder.cs" />
  </ItemGroup>

</Project>